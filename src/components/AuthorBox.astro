---
import config from "@/config";
import AuthorAvatar from "@/assets/images/author.png";

const { site, socials } = config;
---

<section
  class="mt-12 rounded-2xl border border-border bg-card p-8 shadow-sm"
  itemscope
  itemtype="https://schema.org/Person"
>
  <div class="flex flex-col gap-6 md:flex-row md:items-center">

    <img
      src={AuthorAvatar.src}
      alt={site.author}
      itemprop="image"
      class="h-24 w-24 rounded-full border border-border object-cover shadow"
    />

    <div class="flex-1">

      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
        Written by
      </p>

      <h2
        itemprop="name"
        class="mt-1 text-3xl font-bold"
      >
        {site.author}
      </h2>

      <p
        itemprop="description"
        class="mt-4 max-w-3xl leading-8 text-muted-foreground"
      >
        David Treasure writes about AI, blogging, affiliate marketing,
        passive income, freelancing, online surveys, website testing,
        digital products and legitimate ways to make money online.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">

        <div class="mt-6 flex flex-wrap gap-4">

  {
    socials.map((social) => (

      <a
        href={social.url}
        target="_blank"
        rel="me noopener noreferrer"
        itemprop="sameAs"
        aria-label={social.name}
        title={social.name}
        class="flex h-12 w-12 items-center justify-center rounded-full border border-border transition-all duration-300 hover:border-accent hover:bg-accent hover:text-white hover:scale-110"
      >

        {
          social.name === "mail" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M4 5h16v14H4z"/>
              <path d="M4 7l8 6 8-6"/>
            </svg>
          )
        }

        {
          social.name === "x" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M18.9 2H22l-6.8 7.8L23 22h-6.2l-4.8-6.2L6.7 22H3.6l7.3-8.4L1 2h6.3l4.3 5.6L18.9 2z"/>
            </svg>
          )
        }

        {
          social.name === "facebook" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M22 12a10 10 0 10-11.6 9.9v-7H7.7V12h2.7V9.8c0-2.7 1.6-4.2 4-4.2 1.2 0 2.4.2 2.4.2v2.6H15.4c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0022 12z"/>
            </svg>
          )
        }

        {
          social.name === "pinterest" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M12 2a10 10 0 00-3.6 19.3c0-.8 0-2 .4-2.9l1.3-5.4s-.3-.7-.3-1.8c0-1.7 1-3 2.3-3 1.1 0 1.6.8 1.6 1.8 0 1.1-.7 2.7-1.1 4.2-.3 1.2.6 2.1 1.8 2.1 2.2 0 3.7-2.8 3.7-6 0-2.5-1.7-4.3-4.8-4.3-3.5 0-5.6 2.6-5.6 5.5 0 1 .3 1.8.8 2.4.2.2.2.3.2.6l-.2.9c-.1.3-.3.4-.6.3-1.6-.7-2.3-2.5-2.3-4.6 0-3.4 2.9-7.4 8.6-7.4 4.6 0 7.6 3.3 7.6 6.8 0 4.7-2.6 8.3-6.4 8.3-1.3 0-2.4-.7-2.8-1.5l-.8 3c-.3 1-.9 2-1.5 2.8.9.3 1.8.4 2.8.4A10 10 0 0012 2z"/>
            </svg>
          )
        }

        {
          social.name === "medium" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M2 6l2.2 2.6v8.8L2 20V6zm5.5 0l5 11 5-11H22v14h-2V9.7l-4.7 10.3h-1.4L9 9.7V20H7V6h.5z"/>
            </svg>
          )
        }

      </a>

    ))
  }

</div>

      </div>

      <a
        href={site.profile}
        itemprop="url"
        class="mt-6 inline-block font-semibold text-accent hover:underline"
      >
        Learn more →
      </a>

    </div>

  </div>
</section>