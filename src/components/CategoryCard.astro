---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  href: string;
}

const { title, description, image, href } = Astro.props;
---

<a
  href={href}
  class="group block overflow-hidden rounded-2xl border border-gray-200 transition hover:-translate-y-1 hover:shadow-xl dark:border-gray-700"
>
  <Image
    src={image}
    alt={title}
    class="h-56 w-full object-cover transition duration-300 group-hover:scale-105"
  />

  <div class="p-5">
    <h3 class="text-xl font-bold group-hover:text-accent">
      {title}
    </h3>

    <p class="mt-3 text-sm opacity-80">
      {description}
    </p>
  </div>
</a>