---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "./Datetime.astro";

type Props = CollectionEntry<"posts">;

const { id, data, filePath } = Astro.props;

const {
  title,
  ogImage,
  ...props
} = data;
---

<article class="group">

  <a href={getPostUrl(id, filePath, Astro.currentLocale)}>

    {
      ogImage && (
        <div class="overflow-hidden rounded-xl">
          <Image
            src={ogImage}
            alt={title}
            width={700}
            height={420}
            class="aspect-video w-full object-cover transition duration-500 group-hover:scale-105"
          />
        </div>
      )
    }

    <h3
      class="mt-4 text-2xl font-bold leading-tight transition group-hover:text-accent"
    >
      {title}
    </h3>

    <div class="mt-2 text-sm text-gray-500 dark:text-gray-400">
      <Datetime {...props} />
    </div>

  </a>

</article>