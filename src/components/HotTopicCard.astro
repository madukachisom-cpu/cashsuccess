---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "./Datetime.astro";

type Props = CollectionEntry<"posts">;
const { id, data, filePath } = Astro.props;
const { title, ogImage, ...props } = data;
---

<article class="group border-b border-gray-200 py-4 last:border-b-0 dark:border-gray-700">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="flex gap-4 items-start"
  >
    <!-- Small Thumbnail -->
    {
      ogImage && (
        <div class="shrink-0 overflow-hidden rounded-md">
          <Image
            src={ogImage}
            alt={title}
            width={110}
            height={75}
            class="h-[75px] w-[110px] object-cover transition duration-300 group-hover:scale-105"
          />
        </div>
      )
    }

    <!-- Title + Date -->
    <div class="flex-1">
      <h3 class="text-[15px] font-semibold leading-snug text-gray-900 transition group-hover:text-accent dark:text-white sm:text-base">
        {title}
      </h3>
      <div class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
        <Datetime {...props} />
      </div>
    </div>
  </a>
</article>