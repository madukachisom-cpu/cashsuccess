---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import RecentPostCard from "@/components/RecentPostCard.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import HotTopicCard from "@/components/HotTopicCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import CategoryCard from "@/components/CategoryCard.astro";
import { tagData } from "@/data/tags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts
  .filter(({ data }) => !data.featured)
  .slice(0, postsConfig.perIndex);

const recentIds = new Set(
  recentPosts.map(post => post.id)
);

const hotPosts = [...sortedPosts]
  .filter(post => !recentIds.has(post.id))
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
  <section id="hero" class="border-border border-b py-12">

  <form
    action="/search"
    method="GET"
    class="mx-auto mb-10 max-w-3xl"
  >
    <div class="relative">
      <input
        type="search"
        name="q"
        placeholder="Search"
        class="w-full rounded-xl border border-gray-300 bg-white px-6 py-4 pr-32 text-lg shadow-sm focus:border-accent focus:outline-none dark:border-gray-700 dark:bg-gray-900"
      />

      <button
        type="submit"
        class="absolute right-2 top-1/2 -translate-y-1/2 rounded-lg bg-accent px-6 py-2.5 font-medium text-white transition hover:opacity-90"
      >
        Search
      </button>
    </div>
  </form>

  <div class="mx-auto max-w-4xl text-center">

    <h1 class="text-3xl font-extrabold leading-tight sm:text-3xl">
      Discover Legitimate Ways to Make Money Online
    </h1>

    <p class="mx-auto mt-6 max-w-3xl text-lg text-gray-600 dark:text-gray-300">
      Practical guides on AI jobs, paid surveys, freelancing, affiliate marketing,
      passive income, website testing, remote work and digital products.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">

      <a
        href="/tags/ai-powered-side-hustles/"
        class="rounded-full border px-4 py-2 hover:bg-accent hover:text-white transition"
      >
        AI Side Hustles
      </a>

      <a
        href="/tags/get-paid-for-your-opinion/"
        class="rounded-full border px-4 py-2 hover:bg-accent hover:text-white transition"
      >
        Paid Surveys
      </a>

      <a
        href="/tags/website-and-app-testing/"
        class="rounded-full border px-4 py-2 hover:bg-accent hover:text-white transition"
      >
        Website & App Testing
      </a>

      <a
        href="/tags/passive-income/"
        class="rounded-full border px-4 py-2 hover:bg-accent hover:text-white transition"
      >
        Passive Income
      </a>

    </div>

  </div>

</section>

<!-- Hot Topics -->
<section class="py-12 border-border border-b">
  <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold sm:text-3xl">
    🔥 Hot Topics
  </h2>

  <div class="flex flex-col">
    {
      hotPosts.map(post => (
        <HotTopicCard {...post} />
      ))
    }
  </div>
</section>

    <!-- Browse Categories Section -->
    <section id="categories" class="pt-12 pb-6 border-border border-b">
      <h2 class="text-3xl font-bold">
  Explore Categories
</h2>

<p class="mt-2 mb-8 text-gray-500 dark:text-gray-400">
  Browse our carefully selected categories covering AI, freelancing, surveys, blogging, affiliate marketing, passive income and more.
</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {
          Object.entries(tagData).map(([key, category]) => (
            <CategoryCard
              title={category.title}
              image={category.image}
              description={category.description}
              href={`/tags/${key}/`}
            />
          ))
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul class="mt-8 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
  {recentPosts.slice(0, postsConfig.perIndex).map(data => (
    <RecentPostCard {...data} />
  ))}
</ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>